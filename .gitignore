*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store

# NOTE: .meta files are NOT ignored. Unity uses them to remember each asset's
# unique ID (GUID). If you lose a .meta file, every reference to that asset breaks.
